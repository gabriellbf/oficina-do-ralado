# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo .env NUNCA deve ser enviado para o GitHub (ja esta no .gitignore).

# Porta em que o site vai rodar (o Render define isso sozinho).
PORT=3000

# Segredo usado para assinar o cookie de sessao do painel.
# Gere um valor aleatorio, por exemplo com:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Usuario e senha do painel administrativo, criados pelo "npm run seed".
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha

# Caminho do arquivo do banco de dados SQLite.
DATABASE_PATH=./data/oficina.db
