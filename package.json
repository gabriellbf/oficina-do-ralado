{
  "name": "oficina-do-ralado",
  "version": "1.0.0",
  "description": "Site institucional, catalogo de produtos e painel administrativo da Oficina do Ralado (Belo Horizonte/MG)",
  "main": "src/server.js",
  "private": true,
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node src/seed.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "screenshots": "node scripts/screenshots.js"
  },
  "keywords": [
    "borracharia",
    "oficina",
    "express",
    "sqlite"
  ],
  "author": "Projeto de Extensao - Analise e Desenvolvimento de Sistemas",
  "license": "MIT",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "dotenv": "^18.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jest": "^30.5.2",
    "supertest": "^7.2.2"
  }
}
